POSTGRES_DB=dsm5_kg
POSTGRES_USER=dsm5
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432
DSM_KG_DATA_ROOT=/home/alihoosh/projects/kg-books
DSM_KG_DATABASE_URL=postgresql://dsm5:replace-with-a-long-random-password@127.0.0.1:5432/dsm5_kg
DSM_MINIMAL_GRAPH_DATABASE_NAME=dsm5_minimal_graph

# OpenAI-compatible embeddings endpoint. The server/model must support dimensions=128.
EMBEDDING_BASE_URL=http://127.0.0.1:8000/v1
EMBEDDING_API_KEY=not-needed
EMBEDDING_MODEL=replace-with-embedding-model
EMBEDDING_BATCH_SIZE=128
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_MAX_RETRIES=5

MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=root:Milvus
MILVUS_ENTITY_COLLECTION=unconsolidated_entities_v1
MILVUS_ENTITY_DIMENSION=128
MILVUS_PREDICATE_COLLECTION=unconsolidated_predicates_v1
MILVUS_PREDICATE_DIMENSION=128
MILVUS_INSERT_BATCH_SIZE=1000
MILVUS_PORT=19530
MILVUS_WEB_PORT=9091
